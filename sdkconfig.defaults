# Shared by every profile. Per-profile overrides live in sdkconfig.defaults.<profile>.

# Custom A/B OTA layout with web-UI partitions (partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Save crash dumps to the coredump partition for later analysis (idf.py coredump-info).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Certificates are accepted regardless of the clock: the device may have no time source
# (spec section 5). Dates are only displayed when SNTP works.
# CONFIG_MBEDTLS_HAVE_TIME_DATE is not set

# mDNS debug console commands need the console component, which MINIMAL_BUILD leaves out.
# CONFIG_MDNS_ENABLE_CONSOLE_CLI is not set

# Socket budget: the HTTP server needs max_open_sockets (7) + 3 internal sockets, the captive DNS
# server one more, and phones open several connections at once. The default of 10 is too few.
CONFIG_LWIP_MAX_SOCKETS=16

# The device makes its own key and certificate request (CSR path, spec 7.3).
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CSR_WRITE_C=y

# HTTPS server (normal mode). TLS memory on a classic ESP32 without PSRAM: incoming records
# must stay 16 KB (browsers send full-size records), outgoing can be 4 KB, and buffers are
# allocated only while needed (dynamic buffer) so idle sessions cost little.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
